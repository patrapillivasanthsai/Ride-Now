# Copy this file to .env and replace placeholders with real values

# PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ridenow?schema=public"

# Port to run the server on
PORT=3000

# JWT configurations
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="24h"

# Stripe Configurations (Optional for Mock Mode)
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Firebase Configs (Optional for Mock Mode)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-client-email@project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----"

# CORS configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
