// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
}

enum StaffRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  SUPPORT_STAFF
}

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum VehicleType {
  BIKE
  AUTO
  CAB
}

enum RideStatus {
  REQUESTED
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  RIDE_STARTED
  RIDE_COMPLETED
  CANCELLED
  NO_DRIVER_AVAILABLE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum NotificationTargetRole {
  ALL
  CUSTOMER_ONLY
  DRIVER_ONLY
  ADMIN_ONLY
}

enum NotificationType {
  SYSTEM
  OFFER
  RIDE_UPDATE
  PAYMENT
  APPROVAL
  SAFETY
  BROADCAST
}

enum AuditAction {
  DRIVER_APPROVED
  DRIVER_REJECTED
  DRIVER_SUSPENDED
  DRIVER_ACTIVATED
  CUSTOMER_SUSPENDED
  CUSTOMER_REACTIVATED
  RIDE_CANCELLED
  RIDE_DRIVER_ASSIGNED
  PRICING_UPDATED
  STAFF_CREATED
  STAFF_UPDATED
  STAFF_DEACTIVATED
  NOTIFICATION_SENT
  OFFER_CREATED
  OFFER_UPDATED
  SETTING_UPDATED
  RATING_FLAGGED
  RATING_RESOLVED
}

enum DocumentType {
  DRIVING_LICENSE_FRONT
  DRIVING_LICENSE_BACK
  AADHAAR_CARD
  PAN_CARD
  VEHICLE_RC
  VEHICLE_INSURANCE
  COMMERCIAL_PERMIT
}

enum DocumentStatus {
  NOT_STARTED
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum PayoutAccountType {
  BANK_ACCOUNT
  UPI
}

enum WalletTransactionType {
  TRIP_EARNING
  BONUS_INCENTIVE
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SupportCategory {
  RIDE_ISSUES
  PAYMENTS_EARNINGS
  ACCOUNT_DOCUMENTS
  WALLET_WITHDRAWALS
  SAFETY_EMERGENCY
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole
  fcmToken  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Customer?
  driver     Driver?
  adminStaff AdminStaff?
}

model AdminStaff {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole StaffRole @default(SUPPORT_STAFF)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  auditLogs AuditLog[]
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String
  actor      AdminStaff  @relation(fields: [actorId], references: [id])
  action     AuditAction
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Customer {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String?
  phone                String?
  gender               String?
  dob                  DateTime?
  trustedContacts      Json?
  defaultPaymentMethod String    @default("CARD")
  defaultUpiId         String?
  stripeCustomerId     String?
  isSuspended          Boolean   @default(false)
  suspendedAt          DateTime?
  suspendReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  rides         Ride[]
  ratings       Rating[]
  notifications Notification[]
}

model Driver {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String?
  licenseNumber     String?
  phone             String?
  dob               DateTime?
  gender            String?
  selfieUrl         String?
  isApproved        Boolean      @default(false)
  isSuspended       Boolean      @default(false)
  suspendedAt       DateTime?
  suspendReason     String?
  status            DriverStatus @default(OFFLINE)
  walletBalance     Float        @default(0.0)
  totalEarnings     Float        @default(0.0)
  referralCode      String?      @unique
  referredBy        String?
  trainingCompleted Boolean      @default(false)
  trainingProgress  Json?
  preferredArea     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vehicle             Vehicle?
  rides               Ride[]
  driverLocation      DriverLocation?
  ratings             Rating[]
  driverNotifications DriverNotification[]
  declinedRides       RideDeclinedDriver[]
  documents           DriverDocument[]
  payoutAccounts      DriverPayoutAccount[]
  walletTransactions  DriverWalletTransaction[]
  supportTickets      SupportTicket[]
  dutySessions        DriverDutySession[]
}

model Vehicle {
  id          String      @id @default(uuid())
  driverId    String      @unique
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make        String
  model       String
  year        Int
  color       String
  plateNumber String      @unique
  type        VehicleType @default(CAB)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Ride {
  id             String      @id @default(uuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  driverId       String?
  driver         Driver?     @relation(fields: [driverId], references: [id])
  status         RideStatus  @default(REQUESTED)
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  fare           Float
  vehicleType    VehicleType @default(CAB)
  distance       Float       @default(0.0)
  duration       Float       @default(0.0)
  baseFare       Float       @default(0.0)
  distanceFare   Float       @default(0.0)
  timeFare       Float       @default(0.0)
  cancelReason   String?
  cancelledBy    String?
  otp            String?     @default("1234")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  statusHistory   RideStatusHistory[]
  payments        Payment[]
  ratings         Rating[]
  declinedDrivers RideDeclinedDriver[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

model RideDeclinedDriver {
  id        String   @id @default(uuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([rideId, driverId])
  @@index([rideId])
  @@index([driverId])
}

model RideStatusHistory {
  id        String     @id @default(uuid())
  rideId    String
  ride      Ride       @relation(fields: [rideId], references: [id], onDelete: Cascade)
  status    RideStatus
  note      String?
  createdAt DateTime   @default(now())

  @@index([rideId])
}

model Payment {
  id            String        @id @default(uuid())
  rideId        String
  ride          Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  amount        Float
  status        PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CARD)
  provider      String        @default("MOCK") // RAZORPAY, STRIPE, CASH
  transactionId String?       @unique
  orderId       String?       // Razorpay Order ID (e.g. order_xxxx)
  paymentId     String?       // Razorpay Payment ID (e.g. pay_xxxx)
  signature     String?       // Razorpay HMAC Verification Signature
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([rideId])
  @@index([paymentMethod])
  @@index([status])
  @@index([orderId])
  @@index([paymentId])
}

model Rating {
  id          String   @id @default(uuid())
  rideId      String
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  score       Int
  comment     String?
  raterRole   UserRole
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  isFlagged   Boolean  @default(false)
  flagReason  String?
  isResolved  Boolean  @default(false)
  resolveNote String?
  createdAt   DateTime @default(now())

  @@index([rideId])
  @@index([customerId])
  @@index([driverId])
}

model Notification {
  id         String                 @id @default(uuid())
  customerId String?
  customer   Customer?              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body       String
  type       NotificationType       @default(SYSTEM)
  targetRole NotificationTargetRole @default(CUSTOMER_ONLY)
  isRead     Boolean                @default(false)
  offerId    String?
  offer      Offer?                 @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdAt  DateTime               @default(now())

  @@index([customerId])
  @@index([targetRole])
}

model DriverNotification {
  id        String           @id @default(uuid())
  driverId  String
  driver    Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([driverId])
}

model Offer {
  id            String   @id @default(uuid())
  title         String
  description   String
  discountValue Float    @default(0)
  couponCode    String?  @unique
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  notifications Notification[]
}

model Pricing {
  id            String      @id @default(uuid())
  vehicleType   VehicleType @unique
  baseFare      Float
  perKmRate     Float
  perMinuteRate Float
  minimumFare   Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DriverLocation {
  id        String   @id @default(uuid())
  driverId  String   @unique
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt

  @@index([driverId])
}

model DriverDocument {
  id           String         @id @default(uuid())
  driverId     String
  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type         DocumentType
  status       DocumentStatus @default(NOT_STARTED)
  frontUrl     String?
  backUrl      String?
  rejectReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([driverId, type])
  @@index([driverId])
}

model DriverPayoutAccount {
  id                  String            @id @default(uuid())
  driverId            String
  driver              Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type                PayoutAccountType @default(BANK_ACCOUNT)
  accountHolderName   String?
  bankName            String?
  accountNumberMasked String?
  ifscCode            String?
  upiId               String?
  isDefault           Boolean           @default(true)
  isVerified          Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([driverId])
}

model DriverWalletTransaction {
  id          String                  @id @default(uuid())
  driverId    String
  driver      Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount      Float
  type        WalletTransactionType
  status      WalletTransactionStatus @default(COMPLETED)
  description String
  referenceId String?
  createdAt   DateTime                @default(now())

  @@index([driverId])
  @@index([type])
  @@index([createdAt])
}

model SupportTicket {
  id          String              @id @default(uuid())
  userId      String?
  driverId    String?
  driver      Driver?             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  category    SupportCategory     @default(RIDE_ISSUES)
  subject     String
  message     String
  status      SupportTicketStatus @default(OPEN)
  isEmergency Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([driverId])
  @@index([status])
}

model DriverDutySession {
  id              String    @id @default(uuid())
  driverId        String
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationSeconds Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([driverId])
  @@index([startTime])
}
